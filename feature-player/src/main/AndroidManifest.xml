<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- The player's PARTIAL_WAKE_LOCK, held while the buffer is DRY
         (CpuAwakeLock / PlaybackService.bufferForPlayback): with no track
         playing, the audio HAL's wake lock is gone and the fill's timers would
         stop firing if the device slept mid-stall. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <service
            android:name=".playback.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- D1: the pre-generation notification's Stop action (id 43). -->
        <receiver
            android:name=".playback.PregenCancelReceiver"
            android:exported="false" />
    </application>

</manifest>
