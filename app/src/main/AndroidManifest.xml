<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- V1 settings download path (decision #7: explicit, user-consented
         pack downloads) — without this every HTTP request fails with EPERM
         and the DNS layer throws unchecked (crash, observed 2026-08-27). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Notification permission (API 33+, enforced at targetSdk 33+): the
         request in MainActivity.onCreate can only ever be granted if the
         permission is DECLARED here — without this line checkSelfPermission
         stays denied forever and every notify() lands silently in the void
         (the never-seen pregen/terminal notification, coverage-bar redo
         step 6). Media 42, pregen 43 and generation 44 all hang off it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name="io.github.moronigranja.ayvu.AyvuApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- PregenWorker (decisions #42) is Hilt-injected: AyvuApp is
             the Configuration.Provider that hands WorkManager the
             HiltWorkerFactory. The default initializer must not run first (it
             would initialize WorkManager with the reflection factory and win
             the once-only init). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>
        <!-- WorkManager's foreground worker needs an FGS type at targetSdk 34+
             (its own manifest leaves it untyped; the system rejects type-none). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        <activity
            android:name="io.github.moronigranja.ayvu.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- F4: file-manager "Open with Ayvu" land on the library itself
                 (launchMode singleTop keeps a running instance; onNewIntent
                 dispatches the file into the shared importer). octet-stream is
                 included — file managers type books inconsistently; the
                 extension gate is the backstop. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/x-mobipocket-ebook" />
                <data android:mimeType="application/vnd.amazon.ebook" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- Forwarded book-file shares from feature-share (package-qualified
                 custom action — no feature-to-feature edge, A6). -->
            <intent-filter>
                <action android:name="io.github.moronigranja.ayvu.action.IMPORT_BOOK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        </application>
</manifest>