# Built Android output
*.apk
*.aab
*.dex
*.apkm
*.aabb

# Gradle
.gradle/
build/
**/build/

# AGP externalNativeBuild intermediates (core-llm: CMake/ninja scratch inside
# the module dir, not under build/)
.cxx/

# Android Studio / IntelliJ
.idea/
*.iml
*.ipr
*.iws
*.hlk
*.mod

# Local config (SDK path, secrets)
local.properties

# Keystore / signing keys — NEVER commit
*.jks
*.keystore
*.p12
key*.pem
# The release wiring file (decisions #123): points at the keystore OUTSIDE the
# repo and holds its passwords — local only, per machine.
keystore.properties
# …with ONE exception: the pinned DEBUG keystore (decisions #45). Debug builds
# must be signed identically across toolchains (docker images recreate AGP's
# default keystore per container, breaking device re-installs); a debug key is
# not a secret — release signing stays ignored.
!debug.keystore

# Native / CMake / NDK
cmake-build-*/
out/
obj/

# Firebase (contains project secrets)
google-services.json

# ADB / logs
adb.log
*.log

# OS cruft
.DS_Store
Thumbs.db
*.swp

# Phase J NMT models + corpora — runtime downloads, never committed (decisions
# #7/#114); the pinned manifest IS committed (m/nmt/manifest.json). Pass 5b moved
# the ~29 GB of bytes OUT of the working copy (one rename away at
# ../_ayvu-scratch/local-tts-reader/) and left symlinks behind, so the documented
# paths and the tools' defaults keep working; the symlinks themselves stay
# untracked, which is what these rules now cover.
m/nmt/*
__omp_shell("m/nmt/manifest.json")
m/nmt_stage
m/flores

# Gradle's Kotlin DSL session state, created at the repo root on every build
.kotlin/

# Python bytecode
__pycache__/


# Third-party app screenshots (reference material for the idea pool — not to be committed)
docs/prints/

# JVM crash heap dumps (daemon thrash artifacts)
*.hprof
